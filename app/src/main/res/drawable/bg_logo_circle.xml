<?xml version="1.0" encoding="utf-8"?>
<!--
    bg_logo_circle.xml – Circular background badge for the PetCare paw-print logo.
    Matches prototype: 72dp circular white surface with subtle bottom drop shadow lip
    (box-shadow: 0 8px 0 -2px rgba(155, 36, 71, 0.25)).
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Bottom 3D shadow lip layer -->
    <item
        android:top="6dp">
        <shape android:shape="oval">
            <solid android:color="#409B2447" />
        </shape>
    </item>
    <!-- Top white circular surface -->
    <item
        android:bottom="6dp">
        <shape android:shape="oval">
            <solid android:color="?attr/colorSurface" />
        </shape>
    </item>
</layer-list>
