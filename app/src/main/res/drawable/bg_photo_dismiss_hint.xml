<?xml version="1.0" encoding="utf-8"?>
<!--
    bg_photo_dismiss_hint.xml – Translucent pill background for the photo viewer dismiss hint.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/color_photo_hint_scrim" />
    <stroke
        android:width="@dimen/card_elevation"
        android:color="@color/color_close_scrim" />
    <corners android:radius="@dimen/size_20dp" />
</shape>
