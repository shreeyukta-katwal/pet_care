<?xml version="1.0" encoding="utf-8"?>
<!--
    ic_launcher_background.xml – Adaptive launcher icon background layer.
    A solid teal circle that fills the safe zone.
    Colour matches the primary teal brand colour.
-->
<vector
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Teal filled background square (the system masks it to the device's icon shape) -->
    <path
        android:fillColor="#00695C"
        android:pathData="M0,0 L108,0 L108,108 L0,108 Z" />

</vector>
