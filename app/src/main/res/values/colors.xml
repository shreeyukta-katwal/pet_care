<?xml version="1.0" encoding="utf-8"?>
<!--
    colors.xml – Defines all named colour values for the PetCare teal palette.
    These raw colours are referenced by themes.xml via Material 3 colour role names.
    UI code must NEVER reference these directly – use theme attributes (?attr/colorPrimary etc.)
    so that DayNight theming works correctly.

    Palette generated from Material 3 baseline with teal primary hue.
-->
<resources>

    <!-- ── Light theme colours ──────────────────────────────────────── -->

    <!-- Primary teal – main brand colour (buttons, FAB, app bar) -->
    <color name="md_theme_light_primary">#00695C</color>
    <!-- On-primary – text/icon colour drawn on top of primary surfaces -->
    <color name="md_theme_light_onPrimary">#FFFFFF</color>
    <!-- Primary container – lighter teal for chip/card backgrounds -->
    <color name="md_theme_light_primaryContainer">#A7F3D0</color>
    <!-- On-primary container – text colour on primaryContainer -->
    <color name="md_theme_light_onPrimaryContainer">#002116</color>

    <!-- Secondary – complementary accent colour -->
    <color name="md_theme_light_secondary">#4A6358</color>
    <color name="md_theme_light_onSecondary">#FFFFFF</color>
    <color name="md_theme_light_secondaryContainer">#CCE8DC</color>
    <color name="md_theme_light_onSecondaryContainer">#06201A</color>

    <!-- Tertiary – additional accent for chips / highlights -->
    <color name="md_theme_light_tertiary">#3E6374</color>
    <color name="md_theme_light_onTertiary">#FFFFFF</color>
    <color name="md_theme_light_tertiaryContainer">#C2E8FB</color>
    <color name="md_theme_light_onTertiaryContainer">#001F2A</color>

    <!-- Error state colours -->
    <color name="md_theme_light_error">#B3261E</color>
    <color name="md_theme_light_onError">#FFFFFF</color>
    <color name="md_theme_light_errorContainer">#F9DEDC</color>
    <color name="md_theme_light_onErrorContainer">#410E0B</color>

    <!-- Background and surface -->
    <color name="md_theme_light_background">#FAFDFA</color>
    <color name="md_theme_light_onBackground">#191C1B</color>
    <color name="md_theme_light_surface">#FAFDFA</color>
    <color name="md_theme_light_onSurface">#191C1B</color>
    <color name="md_theme_light_surfaceVariant">#DBE5DF</color>
    <color name="md_theme_light_onSurfaceVariant">#3F4945</color>
    <color name="md_theme_light_outline">#6F7974</color>
    <color name="md_theme_light_outlineVariant">#BFC9C3</color>

    <!-- Inverse (for snackbars, etc.) -->
    <color name="md_theme_light_inverseSurface">#2D3130</color>
    <color name="md_theme_light_inverseOnSurface">#EFF1EF</color>
    <color name="md_theme_light_inversePrimary">#6BDDBF</color>

    <!-- ── Dark theme colours ────────────────────────────────────────── -->

    <color name="md_theme_dark_primary">#6BDDBF</color>
    <color name="md_theme_dark_onPrimary">#003829</color>
    <color name="md_theme_dark_primaryContainer">#00513C</color>
    <color name="md_theme_dark_onPrimaryContainer">#A7F3D0</color>

    <color name="md_theme_dark_secondary">#B1CCBF</color>
    <color name="md_theme_dark_onSecondary">#1D352C</color>
    <color name="md_theme_dark_secondaryContainer">#334B41</color>
    <color name="md_theme_dark_onSecondaryContainer">#CCE8DC</color>

    <color name="md_theme_dark_tertiary">#A6CCDE</color>
    <color name="md_theme_dark_onTertiary">#083545</color>
    <color name="md_theme_dark_tertiaryContainer">#254C5C</color>
    <color name="md_theme_dark_onTertiaryContainer">#C2E8FB</color>

    <color name="md_theme_dark_error">#F2B8B5</color>
    <color name="md_theme_dark_onError">#601410</color>
    <color name="md_theme_dark_errorContainer">#8C1D18</color>
    <color name="md_theme_dark_onErrorContainer">#F9DEDC</color>

    <color name="md_theme_dark_background">#191C1B</color>
    <color name="md_theme_dark_onBackground">#E1E3E1</color>
    <color name="md_theme_dark_surface">#191C1B</color>
    <color name="md_theme_dark_onSurface">#E1E3E1</color>
    <color name="md_theme_dark_surfaceVariant">#3F4945</color>
    <color name="md_theme_dark_onSurfaceVariant">#BFC9C3</color>
    <color name="md_theme_dark_outline">#899390</color>
    <color name="md_theme_dark_outlineVariant">#3F4945</color>

    <color name="md_theme_dark_inverseSurface">#E1E3E1</color>
    <color name="md_theme_dark_inverseOnSurface">#191C1B</color>
    <color name="md_theme_dark_inversePrimary">#00695C</color>

</resources>
