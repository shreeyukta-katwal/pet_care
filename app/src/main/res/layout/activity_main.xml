<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_main.xml – Root layout for MainActivity.
    Contains a single NavHostFragment that fills the entire screen.
    All fragment transactions are managed by the Navigation Component.
    This keeps MainActivity lean; all UI lives in Fragments.
-->
<androidx.fragment.app.FragmentContainerView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_host_fragment"
    android:name="androidx.navigation.fragment.NavHostFragment"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:defaultNavHost="true"
    app:navGraph="@navigation/nav_graph" />
