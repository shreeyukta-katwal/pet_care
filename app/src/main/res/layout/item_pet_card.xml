<?xml version="1.0" encoding="utf-8"?>
<!--
    item_pet_card.xml – RecyclerView row for a single pet in PetListFragment.
    Uses a MaterialCardView with:
      • Circular pet photo (80 dp) with placeholder paw icon
      • Pet name (headline / title style)
      • Species and breed on one line
      • Age displayed as a small chip-style text
      • ⋮ overflow menu button (triggers popup for Edit / Delete)
    All colours and text styles reference theme attributes so they work in
    both light and dark mode without any hard-coded values.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_pet"
    style="@style/Widget.PetCare.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/spacing_medium"
    android:layout_marginBottom="@dimen/spacing_medium"
    android:clickable="true"
    android:focusable="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/spacing_medium">

        <!--
            Circular pet photo.
            Loaded via setImageURI(); ic_paw_placeholder used when photoUri is null.
        -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/image_pet_photo"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="@string/cd_pet_photo"
            android:scaleType="centerCrop"
            android:background="@drawable/bg_pet_avatar_small"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.PetCare.Circular"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            tools:src="@drawable/ic_pet_placeholder" />

        <!-- Pet name – prominent title text -->
        <TextView
            android:id="@+id/text_pet_name"
            android:layout_width="@dimen/dimension_zero"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_medium"
            android:textAppearance="@style/TextAppearance.PetCare.TitleMedium"
            android:textColor="?attr/colorOnSurface"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            app:layout_constraintStart_toEndOf="@id/image_pet_photo"
            app:layout_constraintEnd_toStartOf="@id/button_overflow"
            app:layout_constraintTop_toTopOf="@id/image_pet_photo"
            tools:text="Buddy" />

        <!-- Species · Breed -->
        <TextView
            android:id="@+id/text_species_breed"
            android:layout_width="@dimen/dimension_zero"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_medium"
            android:layout_marginTop="@dimen/size_2dp"
            android:textAppearance="@style/TextAppearance.PetCare.BodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:maxLines="1"
            android:ellipsize="end"
            app:layout_constraintStart_toEndOf="@id/image_pet_photo"
            app:layout_constraintEnd_toStartOf="@id/button_overflow"
            app:layout_constraintTop_toBottomOf="@id/text_pet_name"
            tools:text="Dog · Labrador" />

        <!-- Age label -->
        <TextView
            android:id="@+id/text_age"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_medium"
            android:layout_marginTop="@dimen/spacing_xs"
            android:textAppearance="@style/TextAppearance.PetCare.LabelMedium"
            android:textColor="?attr/colorOnPrimaryContainer"
            android:background="@drawable/bg_pet_age_badge"
            android:paddingHorizontal="@dimen/spacing_s"
            android:paddingVertical="@dimen/spacing_xs"
            app:layout_constraintStart_toEndOf="@id/image_pet_photo"
            app:layout_constraintTop_toBottomOf="@id/text_species_breed"
            tools:text="3 yr" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress_pet_today"
            android:layout_width="@dimen/dimension_zero"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_medium"
            android:layout_marginTop="@dimen/spacing_small"
            android:visibility="gone"
            app:indicatorColor="?attr/colorPrimary"
            app:trackColor="?attr/colorSecondaryContainer"
            app:trackThickness="10dp"
            app:trackCornerRadius="5dp"
            app:layout_constraintStart_toEndOf="@id/image_pet_photo"
            app:layout_constraintEnd_toStartOf="@id/button_overflow"
            app:layout_constraintTop_toBottomOf="@id/text_age"
            tools:progress="80"
            tools:visibility="visible" />

        <!-- Progress label -->
        <TextView
            android:id="@+id/text_progress"
            android:layout_width="@dimen/dimension_zero"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_medium"
            android:layout_marginTop="@dimen/spacing_xs"
            android:textAppearance="@style/TextAppearance.PetCare.LabelMedium"
            android:textColor="?attr/colorSecondary"
            app:layout_constraintStart_toEndOf="@id/image_pet_photo"
            app:layout_constraintEnd_toStartOf="@id/button_overflow"
            app:layout_constraintTop_toBottomOf="@id/progress_pet_today"
            tools:text="• 4/6 done" />

        <!-- ⋮ overflow button – anchored top-end of the card (48dp touch target per Material guidelines) -->
        <ImageButton
            android:id="@+id/button_overflow"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_more_options"
            android:src="@drawable/ic_more_vert"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
