<?xml version="1.0" encoding="utf-8"?>
<!--
    item_checklist_header.xml – Category header row for PetChecklistFragment's RecyclerView.
    Displays a 24dp category icon, section header label, and a subtle horizontal divider line.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/spacing_medium"
    android:paddingTop="@dimen/spacing_medium"
    android:paddingBottom="@dimen/spacing_small">

    <!-- Category Icon (24dp, tinted with colorPrimary) -->
    <ImageView
        android:id="@+id/image_category_icon"
        android:layout_width="@dimen/spacing_l"
        android:layout_height="@dimen/spacing_l"
        android:contentDescription="@string/cd_task_category_icon"
        app:tint="?attr/colorPrimary"
        tools:src="@drawable/ic_cat_feeding" />

    <!-- Category Title (shared SectionHeader style) -->
    <TextView
        android:id="@+id/text_category_title"
        style="@style/Widget.PetCare.SectionHeader"
        android:layout_marginStart="@dimen/spacing_small"
        tools:text="Feeding" />

    <!-- Light horizontal divider line -->
    <View
        android:id="@+id/divider_category"
        android:layout_width="@dimen/dimension_zero"
        android:layout_height="@dimen/card_elevation"
        android:layout_marginStart="@dimen/spacing_medium"
        android:layout_weight="1"
        android:background="?attr/colorOutlineVariant" />

</LinearLayout>
