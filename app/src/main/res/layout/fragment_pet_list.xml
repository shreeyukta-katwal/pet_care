<?xml version="1.0" encoding="utf-8"?>
<!-- Pet dashboard. A compact brand bar, useful introduction and one focused empty-state action. -->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    tools:context=".ui.pet.PetListFragment">

    <!-- The top bar opens the page actions menu. -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="false"

        app:elevation="@dimen/dimension_zero">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            style="@style/Widget.PetCare.Toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="@string/screen_pet_list" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- Page identity stays in the content, so it remains clear beside the app brand. -->
        <LinearLayout
            android:id="@+id/page_intro"
            android:layout_width="@dimen/dimension_zero"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/spacing_large"
            android:layout_marginTop="@dimen/spacing_s"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/pet_list_eyebrow"
                android:textAppearance="@style/TextAppearance.PetCare.LabelLarge"
                android:textColor="?attr/colorPrimary"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:text="@string/screen_pet_list"
                android:textAppearance="@style/TextAppearance.PetCare.HeadlineMedium"
                android:textColor="?attr/colorOnSurface"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:text="@string/pet_list_intro"
                android:textAppearance="@style/TextAppearance.PetCare.BodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <!-- Existing pet cards keep their click, gesture and overflow behavior. -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_pets"
            android:layout_width="@dimen/dimension_zero"
            android:layout_height="@dimen/dimension_zero"
            android:clipToPadding="false"
            android:paddingTop="@dimen/spacing_s"
            android:paddingBottom="@dimen/size_104dp"
            android:scrollbars="vertical"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/page_intro"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:listitem="@layout/item_pet_card" />

        <!-- One clear first-use action; the floating action button is hidden in this state. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/empty_state_card"
            style="@style/Widget.PetCare.Card"
            android:layout_width="@dimen/dimension_zero"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/spacing_medium"
            android:layout_marginTop="@dimen/spacing_large"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/page_intro"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/spacing_large"
                android:paddingTop="@dimen/spacing_xlarge"
                android:paddingBottom="@dimen/spacing_xlarge">

                <ImageView
                    android:id="@+id/image_empty"
                    android:layout_width="@dimen/size_112dp"
                    android:layout_height="@dimen/size_112dp"
                    android:contentDescription="@string/cd_no_pets"
                    android:src="@drawable/ic_pets_empty" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_medium"
                    android:text="@string/empty_pets_eyebrow"
                    android:textAppearance="@style/TextAppearance.PetCare.LabelLarge"
                    android:textColor="?attr/colorPrimary"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/text_empty_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:gravity="center"
                    android:text="@string/empty_pets_title"
                    android:textAppearance="@style/TextAppearance.PetCare.HeadlineSmall"
                    android:textColor="?attr/colorOnSurface"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/text_empty_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:gravity="center"
                    android:text="@string/empty_pets_subtitle"
                    android:textAppearance="@style/TextAppearance.PetCare.BodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_empty_add"
                    style="@style/Widget.PetCare.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_large"
                    android:text="@string/action_add_pet"
                    app:icon="@drawable/ic_add" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_add_pet"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/spacing_large"
        android:contentDescription="@string/action_add_pet"
        app:srcCompat="@drawable/ic_add" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
