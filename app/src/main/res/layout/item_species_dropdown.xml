<?xml version="1.0" encoding="utf-8"?>
<!--
    item_species_dropdown.xml – 48dp height dropdown item layout for Species ExposedDropdownMenu.
-->
<TextView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/text_species_item"
    android:layout_width="match_parent"
    android:layout_height="@dimen/touch_target"
    android:minHeight="@dimen/touch_target"
    android:gravity="center_vertical"
    android:paddingHorizontal="@dimen/spacing_medium"
    android:textAppearance="@style/TextAppearance.PetCare.BodyLarge"
    android:textColor="?attr/colorOnSurface"
    android:ellipsize="end"
    android:singleLine="true" />
