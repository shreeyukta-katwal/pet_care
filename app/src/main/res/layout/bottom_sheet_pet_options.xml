<?xml version="1.0" encoding="utf-8"?>
<!--
    bottom_sheet_pet_options.xml – Modern Material 3 bottom sheet for the pet card overflow menu.
    Replaces the basic PopupMenu with a themed sheet showing pet name + icon actions.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="@dimen/spacing_l">

    <!-- Drag handle -->
    <com.google.android.material.bottomsheet.BottomSheetDragHandleView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xs" />

    <!-- Pet name header -->
    <TextView
        android:id="@+id/text_sheet_pet_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/spacing_l"
        android:paddingBottom="@dimen/spacing_s"
        android:textAppearance="@style/TextAppearance.PetCare.TitleMedium"
        android:textColor="?attr/colorOnSurface"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end" />

    <!-- Thin divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="@dimen/spacing_l"
        android:layout_marginBottom="@dimen/spacing_s"
        android:background="?attr/colorOutlineVariant" />

    <!-- Add Routine -->
    <LinearLayout
        android:id="@+id/option_add_routine"
        android:layout_width="match_parent"
        android:layout_height="@dimen/touch_target_sheet"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/spacing_l"
        android:paddingVertical="@dimen/spacing_s">

        <ImageView
            android:layout_width="@dimen/spacing_l"
            android:layout_height="@dimen/spacing_l"
            android:src="@drawable/ic_bell"
            android:contentDescription="@null"
            app:tint="?attr/colorPrimary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_m"
            android:text="@string/action_add_routine"
            android:textAppearance="@style/TextAppearance.PetCare.BodyLarge"
            android:textColor="?attr/colorOnSurface" />

    </LinearLayout>

    <!-- Edit Pet -->
    <LinearLayout
        android:id="@+id/option_edit"
        android:layout_width="match_parent"
        android:layout_height="@dimen/touch_target_sheet"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/spacing_l"
        android:paddingVertical="@dimen/spacing_s">

        <ImageView
            android:layout_width="@dimen/spacing_l"
            android:layout_height="@dimen/spacing_l"
            android:src="@drawable/ic_edit"
            android:contentDescription="@null"
            app:tint="?attr/colorPrimary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_m"
            android:text="@string/action_edit"
            android:textAppearance="@style/TextAppearance.PetCare.BodyLarge"
            android:textColor="?attr/colorOnSurface" />

    </LinearLayout>

    <!-- Thin divider before destructive action -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="@dimen/spacing_l"
        android:layout_marginVertical="@dimen/spacing_xs"
        android:background="?attr/colorOutlineVariant" />

    <!-- Delete Pet (destructive) -->
    <LinearLayout
        android:id="@+id/option_delete"
        android:layout_width="match_parent"
        android:layout_height="@dimen/touch_target_sheet"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/spacing_l"
        android:paddingVertical="@dimen/spacing_s">

        <ImageView
            android:layout_width="@dimen/spacing_l"
            android:layout_height="@dimen/spacing_l"
            android:src="@drawable/ic_delete"
            android:contentDescription="@null"
            app:tint="?attr/colorError" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_m"
            android:text="@string/action_delete"
            android:textAppearance="@style/TextAppearance.PetCare.BodyLarge"
            android:textColor="?attr/colorError" />

    </LinearLayout>

</LinearLayout>
