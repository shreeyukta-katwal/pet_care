<?xml version="1.0" encoding="utf-8"?>
<!--
    item_category_dropdown.xml – Dropdown item layout for TaskCategory ExposedDropdownMenu.
    Displays a category icon alongside its human-readable display name.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/spacing_medium">

    <ImageView
        android:id="@+id/image_category_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="@dimen/spacing_medium"
        android:contentDescription="@string/cd_task_category_icon"
        tools:src="@drawable/ic_cat_feeding" />

    <TextView
        android:id="@+id/text_category_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        android:textColor="?attr/colorOnSurface"
        tools:text="Feeding" />

</LinearLayout>
