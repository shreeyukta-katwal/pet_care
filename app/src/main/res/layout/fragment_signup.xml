<?xml version="1.0" encoding="utf-8"?>
<!--
    fragment_signup.xml – User Registration Screen Layout.

    Structure:
    - NestedScrollView (fillViewport=true): ensures scrollability in landscape and small viewports.
    - Outer ConstraintLayout: fills the scrollable viewport so the inner container centres vertically.
    - Inner ConstraintLayout (cardContainer): capped at 480dp for tablets/landscape.
    - Header: 72dp logo badge, "Create an Account" title, friendly subtitle.
    - Fields: Email → Password → Confirm Password, all using Widget.PetCare.TextInputLayout.OutlinedBox.
      Password toggle end-icons are 24dp drawables inside 48dp hit-targets (endIconMinSize from style).
    - Loading state: LinearProgressIndicator (full-width, indeterminate) sits directly above the primary
      button. GONE collapses it via ConstraintLayout so no gap appears when idle.
    - Primary action: Widget.PetCare.Button (48dp, 12dp corners, match_parent via layout_width).
    - Cross-link: Widget.PetCare.Button.TextButton — a proper text-button, not a styled TextView.
    - All binding IDs from SignupFragment.kt are preserved: tilEmail, etEmail, tilPassword, etPassword,
      tilConfirmPassword, etConfirmPassword, progressBar, btnSignup, btnLoginLink.
-->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="?android:attr/colorBackground">

    <!-- Outer ConstraintLayout fills the viewport so the inner container can be vertically centred. -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="@dimen/spacing_l"
        android:paddingVertical="@dimen/spacing_xl">

        <!-- ── Centered Card Container (capped at 480dp for tablet / landscape) ── -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cardContainer"
            android:layout_width="@dimen/dimension_zero"
            android:layout_height="wrap_content"
            android:padding="@dimen/spacing_s"
            app:layout_constraintWidth_max="@dimen/form_max_width"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintVertical_bias="0">

            <!-- ── Logo Badge (72dp circular container with tinted paw-print icon) ── -->
            <FrameLayout
                android:id="@+id/logoBadge"
                android:layout_width="@dimen/photo_thumbnail_size"
                android:layout_height="@dimen/photo_thumbnail_size"
                android:background="@drawable/bg_logo_circle"
                android:visibility="gone"
                android:padding="@dimen/size_12dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <ImageView
                    android:id="@+id/ivLogo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_petcare_logo"
                    app:tint="?attr/colorPrimary"
                    android:contentDescription="@string/cd_app_logo" />
            </FrameLayout>

            <!-- ── Screen Title ── -->
            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_m"
                android:text="@string/title_signup"
                android:textAppearance="@style/TextAppearance.PetCare.HeadlineMedium"
                android:textColor="?attr/colorOnSurface"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/logoBadge"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- ── Screen Subtitle ── -->
            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="@dimen/dimension_zero"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_6dp"
                android:gravity="start"
                android:visibility="gone"
                android:text="@string/subtitle_signup"
                android:textAppearance="@style/TextAppearance.PetCare.BodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                app:layout_constraintTop_toBottomOf="@id/tvTitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- ── Email Input Field ──
                 Widget.PetCare.TextInputLayout.OutlinedBox: 12dp corners, 48dp icon hit-targets,
                 endIconScaleType=centerInside (prevents oversized icon overlap). -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilEmail"
                style="@style/Widget.PetCare.TextInputLayout.OutlinedBox"
                android:layout_width="@dimen/dimension_zero"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_28dp"
                android:hint="@string/email_label"
                app:errorEnabled="true"
                app:layout_constraintTop_toBottomOf="@id/tvSubtitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textEmailAddress"
                    android:maxLines="1"
                    android:imeOptions="actionNext" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- ── Password Input Field ──
                 endIconMode="password_toggle" provides the visibility toggle.
                 The icon drawable is 24dp; endIconMinSize=48dp (from style) ensures a comfortable
                 48dp hit-target — the icon is never oversized or crowded against the text. -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPassword"
                style="@style/Widget.PetCare.TextInputLayout.OutlinedBox"
                android:layout_width="@dimen/dimension_zero"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_12dp"
                android:hint="@string/password_label"
                app:endIconMode="password_toggle"
                app:errorEnabled="true"
                app:layout_constraintTop_toBottomOf="@id/tilEmail"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:imeOptions="actionNext" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- ── Confirm Password Input Field ──
                 Same toggle treatment as the Password field above. -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilConfirmPassword"
                style="@style/Widget.PetCare.TextInputLayout.OutlinedBox"
                android:layout_width="@dimen/dimension_zero"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_12dp"
                android:hint="@string/confirm_password_label"
                app:endIconMode="password_toggle"
                app:errorEnabled="true"
                app:layout_constraintTop_toBottomOf="@id/tilPassword"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etConfirmPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:imeOptions="actionDone" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- ── Loading Progress Indicator ──
                 LinearProgressIndicator spans the full container width for clear visibility.
                 Visibility is toggled by SignupFragment.observeState(); GONE collapses the view
                 in ConstraintLayout so no gap appears between the fields and the button. -->
            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progressBar"
                android:layout_width="@dimen/dimension_zero"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_20dp"
                android:indeterminate="true"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/tilConfirmPassword"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                tools:visibility="visible" />

            <!-- ── Sign Up Submit Button ──
                 Widget.PetCare.Button: 48dp minHeight, 12dp corners, consistent with app forms.
                 marginTop="@dimen/spacing_s": when progressBar is GONE this provides the gap; when VISIBLE
                 the indicator already carries 20dp top margin so the spacing remains comfortable. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSignup"
                style="@style/Widget.PetCare.Button"
                android:layout_width="@dimen/dimension_zero"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_s"
                android:text="@string/btn_create_account"
                android:contentDescription="@string/cd_btn_signup"
                app:layout_constraintTop_toBottomOf="@id/progressBar"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- ── "Already have an account?" Cross-Link ──
                 Widget.PetCare.Button.TextButton: proper text-button style (no background,
                 no stroke, correct ripple) instead of a styled plain TextView.
                 SignupFragment binds btnLoginLink.setOnClickListener to navigate to Login. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLoginLink"
                style="@style/Widget.PetCare.Button.TextButton"
                android:layout_width="@dimen/dimension_zero"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:text="@string/already_have_account"
                app:layout_constraintTop_toBottomOf="@id/btnSignup"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>
