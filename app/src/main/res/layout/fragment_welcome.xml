<?xml version="1.0" encoding="utf-8"?>
<!--
    fragment_welcome.xml – Welcome / Landing screen layout.
    The primary entry point for unauthenticated users.

    Structure:
    - NestedScrollView (fillViewport=true): ensures scrollability in landscape and small screens.
    - Outer ConstraintLayout: fills the scrollable viewport.
    - Inner ConstraintLayout (contentContainer): capped at 480dp for tablets/landscape.
    - Top Section: 72dp circular logo badge with paw-print icon inside, positioned at top-left.
    - Bottom Section: App brand title ("PetCare"), tagline ("Every pet. Every task. Never missed."),
      and action buttons: filled 'Log In' pill button and solid white 'Sign Up' pill button.
    - welcomeDetailsContainer starts invisible; WelcomeFragment fades it in after the
      session-check coroutine resolves (prevents UI flash during auto-login).
-->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bg_welcome_gradient">

    <!-- Outer ConstraintLayout fills the viewport -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:minHeight="540dp">

        <!-- ── Centered Content Container (capped at 480dp for tablet / landscape) ── -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/contentContainer"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:minHeight="540dp"
            android:paddingHorizontal="22dp"
            android:paddingTop="28dp"
            android:paddingBottom="26dp"
            app:layout_constraintWidth_max="@dimen/form_max_width"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- ── Logo Badge (72dp circular container with 34dp paw-print icon at top-left) ── -->
            <FrameLayout
                android:id="@+id/logoBadge"
                android:layout_width="72dp"
                android:layout_height="78dp"
                android:background="@drawable/bg_logo_circle"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent">

                <!-- Scalable paw-print vector (34dp x 34dp), tinted with ?attr/colorPrimary -->
                <ImageView
                    android:id="@+id/ivLogo"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="19dp"
                    android:src="@drawable/ic_petcare_logo"
                    app:tint="?attr/colorPrimary"
                    android:contentDescription="@string/cd_app_logo" />
            </FrameLayout>

            <!-- ── Welcome Details Container (title + tagline + buttons) ──
                 Positioned at the bottom of the screen.
                 Starts INVISIBLE so only the logo is shown during the session check (zero flash).
                 WelcomeFragment fades this to VISIBLE once the check resolves. -->
            <LinearLayout
                android:id="@+id/welcomeDetailsContainer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="start"
                android:orientation="vertical"
                android:visibility="invisible"
                app:layout_constraintTop_toBottomOf="@id/logoBadge"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintVertical_bias="1.0"
                tools:visibility="visible">

                <!-- ── App Brand Title ── -->
                <TextView
                    android:id="@+id/tvAppName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textAppearance="@style/TextAppearance.PetCare.HeadlineLarge"
                    android:textColor="?attr/colorOnPrimaryContainer"
                    android:textSize="46sp"
                    android:letterSpacing="0"
                    android:textStyle="bold" />

                <!-- ── Tagline (secondary text; #6B4A5C in prototype, max-width ~200dp) ── -->
                <TextView
                    android:id="@+id/tvTagline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_6dp"
                    android:gravity="start"
                    android:maxWidth="220dp"
                    android:text="@string/welcome_tagline"
                    android:textAppearance="@style/TextAppearance.PetCare.BodyLarge"
                    android:textColor="@color/color_welcome_tagline"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:lineSpacingMultiplier="1.35" />

                <!-- ── CTA Buttons ── -->
                <LinearLayout
                    android:id="@+id/actionContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_l"
                    android:orientation="vertical">

                    <!-- Filled 'Log In' pill button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnLogin"
                        style="@style/Widget.PetCare.Button.Welcome"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/btn_login"
                        android:contentDescription="@string/cd_btn_login"
                        android:textAppearance="@style/TextAppearance.PetCare.TitleMedium" />

                    <!-- Solid white 'Sign Up' pill button (12dp gap from Log In) -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSignup"
                        style="@style/Widget.PetCare.Button.Welcome.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/size_12dp"
                        android:text="@string/btn_signup"
                        android:contentDescription="@string/cd_btn_signup"
                        android:textAppearance="@style/TextAppearance.PetCare.TitleMedium" />

                </LinearLayout>

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>
