<?xml version="1.0" encoding="utf-8"?>
<!--
    fragment_task_form.xml – Comprehensive Add / Edit Care Routine (Task) Screen.
    
    Structure:
      CoordinatorLayout (root)
        ├─ AppBarLayout / MaterialToolbar (Dynamic title "Add Care Routine" / "Edit Care Routine", bold title appearance, pet subtitle, up arrow)
        └─ NestedScrollView (max width constrained on tablets to 600dp, clipToPadding=false)
             └─ ConstraintLayout (centers form container up to 600dp)
                  └─ LinearLayout (form_container, 16dp horizontal padding)
                       ├─ No-pets warning container (visible when user has 0 pets)
                       ├─ Section 1: "Who and what" (labelMedium primary header)
                       │    ├─ Pet selector (ExposedDropdownMenu with 28dp avatar and custom list adapter)
                       │    ├─ Task name (required, asterisk in label only)
                       │    └─ Category (ExposedDropdownMenu with category start icon)
                       ├─ Section 2: "When" (labelMedium primary header)
                       │    ├─ Frequency (MaterialButtonToggleGroup with check icon on selected button)
                       │    ├─ Days-of-week ChipGroup (visible ONLY when Weekly selected)
                       │    └─ Time selector (read-only exposed field with clock icon opening MaterialTimePicker)
                       ├─ Section 3: "Details" (labelMedium primary header)
                       │    ├─ Required supplies field (single line with supplies icon)
                       │    ├─ Notes field (dynamic hint for Healthcare, multi-line, top gravity)
                       │    └─ Reminder card row (outlined card with bell icon, title, subtitle, and switch)
                       ├─ Save / Add button (full-width filled rounded button)
                       └─ CircularProgressIndicator
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    tools:context=".ui.task.TaskFormFragment">

    <!-- ── Top App Bar ─────────────────────────────────────────────── -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="false">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_back"
            app:navigationContentDescription="@string/cd_navigate_up"
            app:titleTextAppearance="@style/TextAppearance.PetCare.Toolbar.Title"
            app:subtitleTextAppearance="@style/TextAppearance.PetCare.Toolbar.Subtitle"
            tools:title="@string/title_add_task"
            tools:subtitle="Puppy" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- ── Scrollable form body ────────────────────────────────────── -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- Outer constraint layout centers content up to 600dp on tablets -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/form_container"
                android:layout_width="@dimen/dimension_zero"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/spacing_medium"
                android:paddingTop="@dimen/spacing_medium"
                android:paddingBottom="@dimen/spacing_xlarge"
                app:layout_constraintWidth_max="@dimen/form_max_width_wide"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <!-- The routine builder starts with context, then grouped inputs. -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_large"
                    app:cardBackgroundColor="?attr/colorSecondaryContainer"
                    app:cardCornerRadius="@dimen/card_corner_radius"
                    app:cardElevation="@dimen/dimension_zero">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_large">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/task_form_eyebrow"
                            android:textAppearance="@style/TextAppearance.PetCare.LabelLarge"
                            android:textColor="?attr/colorOnSecondaryContainer" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_small"
                            android:text="@string/task_form_intro"
                            android:textAppearance="@style/TextAppearance.PetCare.TitleLarge"
                            android:textColor="?attr/colorOnSecondaryContainer"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ── No Pets Warning Banner ───────────────────────── -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_no_pets_warning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_medium"
                    android:visibility="gone"
                    app:cardBackgroundColor="?attr/colorErrorContainer"
                    app:cardCornerRadius="@dimen/card_corner_radius"
                    app:strokeColor="?attr/colorError"
                    app:strokeWidth="@dimen/card_elevation"
                    tools:visibility="visible">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_medium">

                        <TextView
                            android:id="@+id/text_no_pets_warning"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/no_pets_warning"
                            android:textAppearance="@style/TextAppearance.PetCare.BodyMedium"
                            android:textColor="?attr/colorOnErrorContainer" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/button_add_pet_first"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_small"
                            android:text="@string/btn_create_pet" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- ── Section 1: Who and what ──────────────────────── -->
                <TextView
                    android:id="@+id/header_who_and_what"
                    style="@style/Widget.PetCare.SectionHeader"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:layout_marginBottom="@dimen/spacing_small"
                    android:text="@string/section_who_and_what" />

                <!-- ── Pet Selector Dropdown ────────────────────────── -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layout_pet"
                    style="@style/Widget.PetCare.TextInputLayout.OutlinedBox.ExposedDropdownMenu.Avatar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_medium"
                    android:hint="@string/label_select_pet"
                    app:startIconDrawable="@drawable/ic_pet_avatar_placeholder"
                    app:startIconContentDescription="@string/cd_pet_avatar">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/dropdown_pet"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        tools:text="Max (Dog)" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- ── Task Name Field ──────────────────────────────── -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layout_name"
                    style="@style/Widget.PetCare.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_medium"
                    android:hint="@string/hint_task_name">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edit_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionNext"
                        android:inputType="textCapSentences"
                        android:maxLines="1" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- ── Category Selector Dropdown ───────────────────── -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layout_category"
                    style="@style/Widget.PetCare.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_medium"
                    android:hint="@string/hint_category"
                    app:startIconDrawable="@drawable/ic_cat_feeding"
                    app:startIconContentDescription="@string/hint_category">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/dropdown_category"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        tools:text="Feeding" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- ── Section 2: When ──────────────────────────────── -->
                <TextView
                    android:id="@+id/header_when"
                    style="@style/Widget.PetCare.SectionHeader"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:layout_marginBottom="@dimen/spacing_small"
                    android:text="@string/section_when" />

                <!-- ── Frequency Toggle Group ───────────────────────── -->
                <TextView
                    android:id="@+id/label_frequency"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_xsmall"
                    android:text="@string/hint_frequency"
                    android:textAppearance="@style/TextAppearance.PetCare.LabelLarge"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/toggle_frequency"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_medium"
                    app:checkedButton="@id/button_freq_daily"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_freq_daily"
                        style="@style/Widget.PetCare.Button.Outlined"
                        android:layout_width="@dimen/dimension_zero"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/frequency_daily"
                        app:icon="@drawable/ic_check"
                        app:iconGravity="textStart" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_freq_weekly"
                        style="@style/Widget.PetCare.Button.Outlined"
                        android:layout_width="@dimen/dimension_zero"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/frequency_weekly"
                        app:iconGravity="textStart" />

                </com.google.android.material.button.MaterialButtonToggleGroup>

                <!-- ── Weekly Days-of-Week Chips Container ─────────── -->
                <!-- Shown only when Frequency is Weekly -->
                <LinearLayout
                    android:id="@+id/container_days_of_week"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_medium"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:id="@+id/label_repeat_on"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_xsmall"
                        android:text="@string/days_of_week_label"
                        android:textAppearance="@style/TextAppearance.PetCare.LabelLarge"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chip_group_days"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:chipSpacingHorizontal="@dimen/spacing_xsmall"
                        app:chipSpacingVertical="@dimen/spacing_xsmall"
                        app:singleLine="false"
                        app:singleSelection="false">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_mon"
                            style="@style/Widget.PetCare.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/chip_mon" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_tue"
                            style="@style/Widget.PetCare.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/chip_tue" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_wed"
                            style="@style/Widget.PetCare.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/chip_wed" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_thu"
                            style="@style/Widget.PetCare.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/chip_thu" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_fri"
                            style="@style/Widget.PetCare.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/chip_fri" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_sat"
                            style="@style/Widget.PetCare.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/chip_sat" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_sun"
                            style="@style/Widget.PetCare.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/chip_sun" />

                    </com.google.android.material.chip.ChipGroup>

                    <TextView
                        android:id="@+id/text_days_error"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/size_2dp"
                        android:text="@string/error_days_required"
                        android:textAppearance="@style/TextAppearance.PetCare.BodySmall"
                        android:textColor="?attr/colorError"
                        android:visibility="gone"
                        tools:visibility="visible" />

                </LinearLayout>

                <!-- ── Time Picker Field ────────────────────────────── -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layout_time"
                    style="@style/Widget.PetCare.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_medium"
                    android:hint="@string/hint_time"
                    app:startIconDrawable="@drawable/ic_clock"
                    app:startIconContentDescription="@string/cd_time_picker">

                    <!--
                        Clickable and non-editable EditText that triggers MaterialTimePicker
                    -->
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edit_time"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:cursorVisible="false"
                        android:focusable="false"
                        android:inputType="none"
                        tools:text="08:00 AM" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- ── Section 3: Details ───────────────────────────── -->
                <TextView
                    android:id="@+id/header_details"
                    style="@style/Widget.PetCare.SectionHeader"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:layout_marginBottom="@dimen/spacing_small"
                    android:text="@string/section_details" />

                <!-- ── Required Supplies Field ──────────────────────── -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layout_supplies"
                    style="@style/Widget.PetCare.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_medium"
                    android:hint="@string/hint_supplies"
                    app:startIconDrawable="@drawable/ic_supplies"
                    app:startIconContentDescription="@string/cd_supplies_icon">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edit_supplies"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionNext"
                        android:inputType="textCapSentences"
                        android:maxLines="1"
                        android:singleLine="true" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- ── Care Notes Field ─────────────────────────────── -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layout_notes"
                    style="@style/Widget.PetCare.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_medium"
                    android:hint="@string/hint_task_notes">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edit_notes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top"
                        android:imeOptions="actionDone"
                        android:inputType="textMultiLine|textCapSentences"
                        android:minLines="3"
                        android:maxLines="6" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- ── Reminder Card Row ────────────────────────────── -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_reminder"
                    style="@style/Widget.PetCare.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_large">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/size_64dp"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/spacing_medium"
                        android:paddingVertical="@dimen/spacing_small">

                        <ImageView
                            android:id="@+id/image_reminder_icon"
                            android:layout_width="@dimen/spacing_l"
                            android:layout_height="@dimen/spacing_l"
                            android:layout_marginEnd="@dimen/spacing_medium"
                            android:contentDescription="@string/cd_reminder_icon"
                            android:src="@drawable/ic_bell"
                            app:tint="?attr/colorPrimary" />

                        <LinearLayout
                            android:layout_width="@dimen/dimension_zero"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/text_reminder_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/reminder_title"
                                android:textAppearance="@style/TextAppearance.PetCare.TitleMedium"
                                android:textColor="?attr/colorOnSurface" />

                            <TextView
                                android:id="@+id/text_reminder_subtitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/reminder_subtitle"
                                android:textAppearance="@style/TextAppearance.PetCare.BodySmall"
                                android:textColor="?attr/colorOnSurfaceVariant" />

                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switch_reminder"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_small"
                            android:checked="true" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- ── Save / Add Button ────────────────────────────── -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_save"
                    style="@style/Widget.PetCare.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_large"
                    tools:text="@string/btn_save_routine" />

                <!-- CircularProgressIndicator for asynchronous save -->
                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/progress_indicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="@dimen/spacing_medium"
                    android:indeterminate="true"
                    android:visibility="gone"
                    app:indicatorSize="@dimen/spacing_xl"
                    app:trackCornerRadius="@dimen/spacing_xs" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
